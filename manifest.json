{
  "manifest_version": 3,
  "name": "URLCollector",
  "version": "1.1",
  "description": "Collect, filter, sort and copy URLs from all browser tabs",
  "permissions": [
    "tabs",
    "storage",
    "tabGroups",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "copy_urls": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "MacCtrl+Shift+C"
      },
      "description": "Copy all URLs"
    },
    "sleep_tabs": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "MacCtrl+S"
      },
      "description": "Sleep inactive tabs"
    }
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "URLCollector"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; object-src 'self'"
  }
}
